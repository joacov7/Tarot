# ============================================================================
# Tarot Híbrido — variables de entorno (SOLO NOMBRES, sin valores reales)
# Copiar a .env.local y completar. NUNCA versionar .env.local
# ============================================================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # SOLO servidor/worker, nunca en el cliente

# --- Base de datos (para migraciones / repositorios server con Drizzle o pg) ---
DATABASE_URL=

# --- Colas asíncronas (Inngest) ---
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Pagos: Mercado Pago ---
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# --- Pagos: Stripe (futuro, por abstracción) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- IA: OpenAI ---
AI_PROVIDER=openai
OPENAI_API_KEY=
AI_MODEL_EXPRESS=gpt-4o-mini
AI_MODEL_PREMIUM=gpt-4o

# --- Email: Resend ---
RESEND_API_KEY=
EMAIL_FROM=

# --- App ---
APP_BASE_URL=http://localhost:3000
SIGNED_URL_TTL_SECONDS=3600
